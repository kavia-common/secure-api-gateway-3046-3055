# Copy to .env and set secure values in your environment

# REQUIRED: Secret key for signing JWTs (use a long random value)
SECRET_KEY=change_this_super_secret_key

# Optional: JWT signing algorithm (default HS256)
ALGORITHM=HS256

# Optional: Access token expiration in minutes (default 60)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Optional: Database URL (default sqlite:///./app.db)
DATABASE_URL=sqlite:///./app.db

# Optional: CORS allowed origins (comma-separated). Default: *
CORS_ALLOW_ORIGINS=*
